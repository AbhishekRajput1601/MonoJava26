<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Course Registration Portal</title>
    <link rel="stylesheet" href="assets/css/app.css">
</head>
<body>
<main class="page-wrap">
    <section class="card">
        <header class="header">
            <span class="badge">Student Course Registration Portal</span>
            <h1>Build your career with the right course</h1>
            <p>
                Register for hands-on job-ready tracks in full-stack development and analytics.
                Pick your preferred batch and get started quickly.
            </p>
        </header>

        <div class="actions">
            <a href="register.jsp" class="btn btn-primary">Start Registration</a>
        </div>

        <div class="grid-2" aria-label="Portal highlights">
            <article class="feature">
                <strong>Industry-focused curriculum</strong>
                <span>Practical modules aligned with current hiring needs.</span>
            </article>
            <article class="feature">
                <strong>Flexible batch slots</strong>
                <span>Morning, afternoon, and evening timings available.</span>
            </article>
            <article class="feature">
                <strong>Project-based learning</strong>
                <span>Real projects to strengthen your portfolio and confidence.</span>
            </article>
            <article class="feature">
                <strong>Career support</strong>
                <span>Guidance to help you transition to your target role.</span>
            </article>
        </div>

        <p class="footer-text">&copy; 2026 Student Course Registration Portal</p>
    </section>
